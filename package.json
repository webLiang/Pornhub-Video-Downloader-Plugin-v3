{
  "name": "pornhub-video-downloader-plugin-v3",
  "version": "1.1.7",
  "description": "Pornhub视频xvideos视频下载。 ",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/webLiang/Pornhub-Video-Downloader-Plugin-v3"
  },
  "scripts": {
    "build:core": "node scripts/build-obfuscated.mjs",
    "build": "pnpm build:core && tsc --noEmit && vite build",
    "build:firefox": "tsc --noEmit && cross-env __FIREFOX__=true vite build",
    "build:watch": "cross-env __DEV__=true vite build -w --mode development",
    "build:firefox:watch": "cross-env __DEV__=true __FIREFOX__=true vite build -w --mode development",
    "build:hmr": "rollup --config utils/reload/rollup.config.mjs",
    "wss": "node utils/reload/initReloadServer.js",
    "dev": "pnpm build:hmr && (run-p wss build:watch)",
    "dev:firefox": "pnpm build:hmr && (run-p wss build:firefox:watch)",
    "test": "vitest",
    "commitlint": "commitlint --edit",
    "lint": "eslint src --ext .ts,.js,.tsx,.jsx",
    "lint:fix": "pnpm lint --fix",
    "prettier": "prettier . --write",
    "prepare": "husky install",
    "build:crx": "pnpm build && node utils/create-crx.cjs",
    "release:github:dry": "node scripts/github-release.mjs --dry-run",
    "release:github": "node scripts/github-release.mjs --publish --commit --push",
    "release:github:full": "node scripts/github-release.mjs --full",
    "video-core:init": "git submodule update --init --recursive",
    "video-core:pull": "bash scripts/video-core-pull.sh",
    "video-core:push": "git -C src/pages/background/utils/video-download-core push origin main",
    "video-core:push-subtree-once": "git subtree split --prefix=src/pages/background/utils/video-download-core -b video-core-split && git push video-core video-core-split:main && git branch -D video-core-split",
    "video-core:migrate-submodule": "bash scripts/migrate-video-core-to-submodule.sh"
  },
  "type": "module",
  "dependencies": {
    "@preact/preset-vite": "^2.10.6",
    "construct-style-sheets-polyfill": "3.1.0",
    "crx3": "^1.1.3",
    "m3u8-parser": "^7.1.0",
    "mediabunny": "^1.26.0",
    "mux.js": "^6.3.0",
    "preact": "^10.20.2",
    "webextension-polyfill": "0.10.0"
  },
  "devDependencies": {
    "@commitlint/cli": "18.4.4",
    "@commitlint/config-conventional": "18.1.0",
    "@rollup/plugin-sucrase": "^5.0.2",
    "@rollup/plugin-typescript": "11.1.6",
    "@testing-library/preact": "^3.2.4",
    "@types/chrome": "0.0.263",
    "@types/node": "^20.19.0",
    "@types/ws": "8.5.8",
    "@typescript-eslint/eslint-plugin": "6.10.0",
    "@typescript-eslint/parser": "6.18.1",
    "chokidar": "3.5.3",
    "cross-env": "7.0.3",
    "esbuild": "~0.19.5",
    "eslint": "8.56.0",
    "eslint-config-airbnb-typescript": "17.1.0",
    "eslint-config-prettier": "9.0.0",
    "eslint-plugin-import": "2.29.1",
    "eslint-plugin-jsx-a11y": "6.8.0",
    "eslint-plugin-prettier": "5.1.3",
    "eslint-plugin-react": "7.33.2",
    "eslint-plugin-react-hooks": "4.6.0",
    "fs-extra": "11.1.1",
    "husky": "8.0.3",
    "javascript-obfuscator": "^5.3.0",
    "jsdom": "^22.1.0",
    "lint-staged": "15.2.0",
    "magic-string": "^0.30.6",
    "npm-run-all": "4.1.5",
    "prettier": "3.2.5",
    "rollup": "^4.62.0",
    "sass": "^1.85.0",
    "ts-loader": "9.5.0",
    "tslib": "2.6.2",
    "typescript": "5.2.2",
    "vite": "8.1.5",
    "vitest": "^4.1.10",
    "ws": "8.14.2"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "packageManager": "pnpm@11.13.1"
}
